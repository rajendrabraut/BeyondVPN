# Copy to deploy/.env and fill in. Never commit the real file.
BEYOND_DOMAIN=vpn.example.com
POSTGRES_PASSWORD=change-me-long-random
BEYOND_ADMIN_EMAIL=admin@example.com
# Remove after first start; then rotate the admin password from the portal.
BEYOND_ADMIN_PASSWORD=ChangeMe-Admin-2026
BEYOND_LOG_RETENTION_DAYS=30
BEYOND_ALLOW_REGISTRATION=true
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BEYOND_SIGNING_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BEYOND_DATA_KEY=
# Optional SSO, see docs/SSO.md. Example (single line):
# BEYOND_OIDC_PROVIDERS=[{"id":"corp","name":"Contoso","issuer":"https://login.microsoftonline.com/<tenant>/v2.0","client_id":"<app-id>","allowed_domains":["contoso.com"]}]
BEYOND_OIDC_PROVIDERS=
BEYOND_OIDC_SECRET_CORP=
# Only for several control-plane replicas: shared rate limits (redis://host:6379/0). Empty = in-process.
BEYOND_REDIS_URL=
